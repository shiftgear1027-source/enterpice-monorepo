{
  "name": "@company/shared-api",
  "version": "1.0.0",
  "private": true,
  "description": "Axios instance, interceptors, error handling, services and mock adapter",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "catalog:",
    "@company/shared-types": "workspace:*",
    "@company/shared-config": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
